{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qrwty-ledger-events-v1",
  "title": "QRWTY run ledger event, schema version 1",
  "description": "One JSON object per line of <run>/<ledger>/events.jsonl. ledger.py validates this schema (a documented keyword subset: type, enum, const, pattern, minimum, required, properties, additionalProperties, items, minItems, oneOf, $ref) and then the cross-record rules in README.md. Unknown keys are rejected so that ad-hoc totals cannot enter the ledger.",
  "oneOf": [
    { "$ref": "#/$defs/attempt" },
    { "$ref": "#/$defs/attemptUpdate" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/human" }
  ],
  "$defs": {
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "tsOrNull": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha256OrNull": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "gitShaOrNull": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
    "relPath": {
      "description": "Repository-root-relative POSIX path; no leading slash, no '..' segment.",
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\s].*$"
    },
    "relPathOrNull": {
      "type": ["string", "null"],
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\s].*$"
    },
    "text": { "type": "string", "pattern": "\\S" },
    "textOrNull": { "type": ["string", "null"], "pattern": "\\S" },
    "countOrNull": { "type": ["integer", "null"], "minimum": 0 },
    "numberOrNull": { "type": ["number", "null"], "minimum": 0 },
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/relPath" },
        "sha256": { "$ref": "#/$defs/sha256OrNull" }
      }
    },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "counters": {
      "description": "Provider counters exactly as reported (Anthropic Messages API semantics: input_tokens excludes cache writes and cache reads; reasoning is inside output_tokens). Never add a summed total here.",
      "type": "object",
      "required": [
        "input_tokens",
        "cache_creation_input_tokens",
        "cache_read_input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "$ref": "#/$defs/countOrNull" },
        "cache_creation_input_tokens": { "$ref": "#/$defs/countOrNull" },
        "cache_read_input_tokens": { "$ref": "#/$defs/countOrNull" },
        "output_tokens": { "$ref": "#/$defs/countOrNull" }
      }
    },
    "extraCounters": {
      "description": "Any other numeric provider usage field, copied unchanged and never merged into counters.",
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "usageSource": {
      "type": ["object", "null"],
      "required": ["tool", "artifact"],
      "additionalProperties": false,
      "properties": {
        "tool": { "$ref": "#/$defs/text" },
        "artifact": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }]
        }
      }
    },
    "usage": {
      "type": "object",
      "required": [
        "coverage",
        "coverageReason",
        "pending",
        "requestCount",
        "counters",
        "extraCounters",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "coverage": { "enum": ["reported", "partial", "unavailable"] },
        "coverageReason": { "$ref": "#/$defs/textOrNull" },
        "pending": {
          "description": "true while the coordinator still has to extract usage for this attempt.",
          "type": "boolean"
        },
        "requestCount": { "$ref": "#/$defs/countOrNull" },
        "counters": { "$ref": "#/$defs/counters" },
        "extraCounters": { "$ref": "#/$defs/extraCounters" },
        "source": { "$ref": "#/$defs/usageSource" }
      }
    },
    "model": {
      "type": "object",
      "required": ["requested", "actualModelIds", "actualSource"],
      "additionalProperties": false,
      "properties": {
        "requested": {
          "type": "object",
          "required": ["agentTool", "subagentType", "model", "effort"],
          "additionalProperties": false,
          "properties": {
            "agentTool": { "$ref": "#/$defs/textOrNull" },
            "subagentType": { "$ref": "#/$defs/textOrNull" },
            "model": { "$ref": "#/$defs/textOrNull" },
            "effort": { "$ref": "#/$defs/textOrNull" }
          }
        },
        "actualModelIds": {
          "description": "Model IDs read from transcript message.model, never assumed.",
          "oneOf": [
            { "type": "null" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }
          ]
        },
        "actualSource": { "$ref": "#/$defs/textOrNull" }
      }
    },
    "agentToolTotals": {
      "description": "The Agent tool completion notice: whole-worker totals. Never summed with request counters.",
      "type": "object",
      "required": ["totalTokens", "toolUses", "durationMs", "source"],
      "additionalProperties": false,
      "properties": {
        "totalTokens": { "$ref": "#/$defs/countOrNull" },
        "toolUses": { "$ref": "#/$defs/countOrNull" },
        "durationMs": { "$ref": "#/$defs/countOrNull" },
        "source": { "$ref": "#/$defs/textOrNull" }
      }
    },
    "cost": {
      "type": "object",
      "required": ["reportedUsd", "reportedSource", "estimate"],
      "additionalProperties": false,
      "properties": {
        "reportedUsd": { "$ref": "#/$defs/numberOrNull" },
        "reportedSource": { "$ref": "#/$defs/textOrNull" },
        "estimate": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["usd", "label", "priceSource", "priceDate", "method"],
              "additionalProperties": false,
              "properties": {
                "usd": { "type": "number", "minimum": 0 },
                "label": { "const": "estimate" },
                "priceSource": { "$ref": "#/$defs/text" },
                "priceDate": { "$ref": "#/$defs/date" },
                "method": { "$ref": "#/$defs/text" }
              }
            }
          ]
        }
      }
    },
    "commits": {
      "type": "object",
      "required": ["before", "after"],
      "additionalProperties": false,
      "properties": {
        "before": { "$ref": "#/$defs/gitShaOrNull" },
        "after": { "$ref": "#/$defs/gitShaOrNull" }
      }
    },
    "prompt": {
      "type": "object",
      "required": ["assignmentPath", "assignmentSha256", "ownerInstructionCount"],
      "additionalProperties": false,
      "properties": {
        "assignmentPath": { "$ref": "#/$defs/relPathOrNull" },
        "assignmentSha256": { "$ref": "#/$defs/sha256OrNull" },
        "ownerInstructionCount": { "$ref": "#/$defs/countOrNull" }
      }
    },
    "role": {
      "enum": [
        "implementer",
        "reviewer",
        "repair",
        "coordinator",
        "planner",
        "template-development",
        "shared-tooling"
      ]
    },
    "phase": {
      "enum": [
        "planning",
        "coordination",
        "shared-preparation",
        "architecture",
        "generation-baseline",
        "template-development",
        "backend",
        "ui",
        "deployment-preparation",
        "cloud",
        "review",
        "measurement",
        "maintenance"
      ]
    },
    "status": {
      "enum": ["started", "passed", "failed", "blocked", "needs-owner-review", "cancelled"]
    },
    "attempt": {
      "description": "One worker attempt (implementer, reviewer, repair, coordinator, planner, template or shared tooling).",
      "type": "object",
      "required": [
        "schemaVersion", "eventId", "runId", "ledger", "kind", "recordedAt", "recordedBy",
        "unit", "attempt", "role", "phase", "repository", "status", "startedAt", "endedAt",
        "commits", "prompt", "model", "usage", "agentToolTotals", "cost", "humanMinutes",
        "evidence", "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "eventId": { "type": "string", "pattern": "^(a|b|shared)-[0-9]{4,}$" },
        "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "ledger": { "enum": ["a", "b", "shared"] },
        "kind": { "const": "attempt" },
        "recordedAt": { "$ref": "#/$defs/ts" },
        "recordedBy": { "$ref": "#/$defs/text" },
        "unit": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9._-]*$" },
        "attempt": { "type": "integer", "minimum": 1 },
        "role": { "$ref": "#/$defs/role" },
        "phase": { "$ref": "#/$defs/phase" },
        "repository": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/status" },
        "startedAt": { "$ref": "#/$defs/tsOrNull" },
        "endedAt": { "$ref": "#/$defs/tsOrNull" },
        "commits": { "$ref": "#/$defs/commits" },
        "prompt": { "$ref": "#/$defs/prompt" },
        "model": { "$ref": "#/$defs/model" },
        "usage": { "$ref": "#/$defs/usage" },
        "agentToolTotals": { "$ref": "#/$defs/agentToolTotals" },
        "cost": { "$ref": "#/$defs/cost" },
        "humanMinutes": { "$ref": "#/$defs/numberOrNull" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "notes": { "$ref": "#/$defs/textOrNull" }
      }
    },
    "attemptUpdate": {
      "description": "Append-only correction or completion of an earlier attempt. Present fields replace the earlier values, in file order.",
      "type": "object",
      "required": [
        "schemaVersion", "eventId", "runId", "ledger", "kind", "recordedAt", "recordedBy",
        "updates", "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "eventId": { "type": "string", "pattern": "^(a|b|shared)-[0-9]{4,}$" },
        "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "ledger": { "enum": ["a", "b", "shared"] },
        "kind": { "const": "attempt-update" },
        "recordedAt": { "$ref": "#/$defs/ts" },
        "recordedBy": { "$ref": "#/$defs/text" },
        "updates": { "type": "string", "pattern": "^(a|b|shared)-[0-9]{4,}$" },
        "reason": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/status" },
        "endedAt": { "$ref": "#/$defs/tsOrNull" },
        "commits": { "$ref": "#/$defs/commits" },
        "model": { "$ref": "#/$defs/model" },
        "usage": { "$ref": "#/$defs/usage" },
        "agentToolTotals": { "$ref": "#/$defs/agentToolTotals" },
        "cost": { "$ref": "#/$defs/cost" },
        "humanMinutes": { "$ref": "#/$defs/numberOrNull" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "notes": { "$ref": "#/$defs/textOrNull" }
      }
    },
    "request": {
      "description": "One provider model request, deduplicated by provider message ID.",
      "type": "object",
      "required": [
        "schemaVersion", "eventId", "runId", "ledger", "kind", "recordedAt", "recordedBy",
        "attemptEventId", "requestId", "timestamp", "provider", "model", "usage", "source"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "eventId": { "type": "string", "pattern": "^(a|b|shared)-[0-9]{4,}$" },
        "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "ledger": { "enum": ["a", "b", "shared"] },
        "kind": { "const": "request" },
        "recordedAt": { "$ref": "#/$defs/ts" },
        "recordedBy": { "$ref": "#/$defs/text" },
        "attemptEventId": { "type": "string", "pattern": "^(a|b|shared)-[0-9]{4,}$" },
        "requestId": { "$ref": "#/$defs/text" },
        "timestamp": { "$ref": "#/$defs/tsOrNull" },
        "provider": { "$ref": "#/$defs/text" },
        "model": { "$ref": "#/$defs/textOrNull" },
        "usage": {
          "type": "object",
          "required": ["counters", "extraCounters"],
          "additionalProperties": false,
          "properties": {
            "counters": { "$ref": "#/$defs/counters" },
            "extraCounters": { "$ref": "#/$defs/extraCounters" }
          }
        },
        "source": {
          "type": "object",
          "required": ["tool", "artifact"],
          "additionalProperties": false,
          "properties": {
            "tool": { "$ref": "#/$defs/text" },
            "artifact": { "$ref": "#/$defs/artifact" }
          }
        }
      }
    },
    "human": {
      "description": "Owner or other human effort: instructions, steering, reviews, debugging help, operations.",
      "type": "object",
      "required": [
        "schemaVersion", "eventId", "runId", "ledger", "kind", "recordedAt", "recordedBy",
        "unit", "who", "activity", "occurredAt", "messageCount", "minutes", "description", "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "eventId": { "type": "string", "pattern": "^(a|b|shared)-[0-9]{4,}$" },
        "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "ledger": { "enum": ["a", "b", "shared"] },
        "kind": { "const": "human" },
        "recordedAt": { "$ref": "#/$defs/ts" },
        "recordedBy": { "$ref": "#/$defs/text" },
        "unit": {
          "type": ["string", "null"],
          "pattern": "^[A-Z][A-Za-z0-9._-]*$"
        },
        "who": { "$ref": "#/$defs/text" },
        "activity": {
          "enum": [
            "owner-instruction",
            "owner-steering",
            "owner-review",
            "debugging-help",
            "operations",
            "decision"
          ]
        },
        "occurredAt": { "$ref": "#/$defs/tsOrNull" },
        "messageCount": { "$ref": "#/$defs/countOrNull" },
        "minutes": { "$ref": "#/$defs/numberOrNull" },
        "description": { "$ref": "#/$defs/text" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}
