ervice-links","kind":"uses-database","planned":{"interaction":"Request / response","label":"Reads public routes on a cache miss","protocol":"SQL","security":"Private network"},"to":{"element":"links"}},{"from":{"element":"redirect-service"},"id":"redirect-service-hot-routes","kind":"uses-database","planned":{"interaction":"Request / response","label":"Reads routes, fills on a miss","protocol":"Redis","security":"Private network"},"to":{"element":"hot-routes"}},{"from":{"element":"redirect-service"},"id":"redirect-service-click-events","kind":"depends-on","planned":{"interaction":"Asynchronous","label":"Publishes clicks and awaits the ACK","protocol":"Messaging","security":"Private network"},"to":{"element":"click-events"}},{"from":{"element":"click-events"},"id":"click-events-analytics-worker","kind":"depends-on","planned":{"interaction":"Asynchronous","label":"Delivers clicks","protocol":"Messaging","security":"Private network"},"to":{"element":"analytics-worker"}},{"from":{"element":"analytics-worker"},"id":"analytics-worker-analytics","kind":"uses-database","planned":{"interaction":"Request / response","label":"Writes aggregates","protocol":"SQL","security":"Private network"},"to":{"element":"analytics"}},{"from":{"element":"account-api"},"id":"account-api-identity","kind":"calls","planned":{"interaction":"Request / response","label":"Calls","protocol":"HTTP","security":"Private network"},"to":{"element":"identity"}},{"from":{"element":"account-api"},"id":"account-api-links","kind":"uses-database","planned":{"interaction":"Request / response","label":"Reads the owner view","protocol":"SQL","security":"Private network"},"to":{"element":"links"}},{"from":{"element":"account-api"},"id":"account-api-analytics","kind":"uses-database","planned":{"interaction":"Request / response","label":"Reads click aggregates","protocol":"SQL","security":"Private network"},"to":{"element":"analytics"}},{"from":{"element":"account-api"},"id":"account-api-billing-api","kind":"calls","planned":{"interaction":"Request / response","label":"Calls","protocol":"HTTP","security":"Private network"},"to":{"element":"billing-api"}},{"from":{"element":"billing-api"},"id":"billing-api-identity","kind":"calls","planned":{"interaction":"Request / response","label":"Calls","protocol":"HTTP","security":"Private network"},"to":{"element":"identity"}},{"from":{"element":"billing-api"},"id":"billing-api-billing","kind":"uses-database","planned":{"interaction":"Request / response","label":"Reads & writes","protocol":"SQL","security":"Private network"},"to":{"element":"billing"}},{"from":{"element":"billing-api"},"id":"billing-api-stripe-api","kind":"calls","planned":{"interaction":"Request / response","label":"Calls","protocol":"HTTP","security":"Private network"},"to":{"element":"stripe-api"}}],"elements":[{"classification":{"kind":"Application"},"description":"Same-origin browser facade: OIDC code + PKCE sign-in, cookie sessions and CSRF. Forwards a valid bearer token (none on guest create) to the Link, Account and Billing APIs; never invents an identity header.","id":"session-api","name":"Session API"},{"classification":{"kind":"Application"},"description":"Verified account identity over OIDC. Local Keycloak while testing; the managed issuer is a deployment compatibility decision.","id":"identity","name":"Identity"},{"classification":{"kind":"Data store"},"description":"Encrypted tokens, session expiry and revocation state. A separate restricted PostgreSQL logical database, written only by Session API and never queried by the Redirect service.","id":"sessions","name":"Sessions"},{"classification":{"kind":"Application"},"description":"Guest create, claim with one-time proof, owned edits and deletes, abuse reports and operator decisions. Sole writer of Links; asks Billing API for entitlement grants on owned operations.","id":"link-api","name":"Link API"},{"classification":{"kind":"Application"},"description":"Signed-in reads: the caller's own links and their analytics. Reads the Links owner view and Analytics, checks entitlements with Billing API, and forwards no writes.","id":"account-api","name":"Account API"},{"classification":{"kind":"Application"},"description":"Hosted Checkout and portal, a signature-verified Stripe webhook inbox, subscription reconciliation and entitlement grants. Sole writer of Billing.","id":"billing-api","name":"Billing API"},{"classification":{"kind":"Data store"},"description":"Durable routes, ownership, claim and idempotency data and tombstones. PostgreSQL; the public route view and the account owner view have separate grants.","id":"links","name":"Links"},{"classification":{"kind":"Data store"},"description":"Approximate distributed abuse and admission counters (Valkey). Durable hard account limits stay in Links transactions.","id":"admission-cache","name":"Admission cache"},{"classification":{"kind":"External system"},"description":"Destination reputation check before a link is created. Unavailable means a retryable 503 on create; existing redirects continue.","id":"reputation-api","name":"Reputation API"},{"classification":{"kind":"Application"},"description":"Resolves host and slug, checks state and expiry, awaits the durable click acknowledgment, then answers 302. No sign-in or payment dependency.","id":"redirect-service","name":"Redirect service"},{"classification":{"kind":"Data store"},"description":"Short-lived route metadata with a bounded freshness deadline (Valkey). Replaceable, never the source of truth.","id":"hot-routes","name":"Hot routes"},{"classification":{"kind":"Data store"},"description":"Click events, durably acknowledged before each redirect. Production transport is GCP Pub/Sub, pending G12; the local export uses the installed broker. The archive subscription is deployment.","id":"click-events","name":"Click events"},{"classification":{"kind":"Application"},"description":"Validates, deduplicates and aggregates click events, expires bounded data and acknowledges only after its transaction commits. Sole writer of Analytics.","id":"analytics-worker","name":"Analytics worker"},{"classification":{"kind":"Data store"},"description":"Click aggregates plus bounded deduplication data. A separate PostgreSQL logical database, read by Account API.","id":"analytics","name":"Analytics"},{"classification":{"kind":"Data store"},"description":"Customer mappings, webhook inbox, subscription and entitlement revisions, reconciliation jobs and action idempotency. Restricted PostgreSQL logical database; no card data.","id":"billing","name":"Billing"},{"classification":{"kind":"External system"},"description":"Hosted payments and subscriptions (test mode). Its signed webhook reaches Billing API through the Create, manage & pay entry, not a line out of this tile.","id":"stripe-api","name":"Stripe API"}],"generation":{"processes":true,"runtime":{"id":"local-runtime","sha256":"71dcdadd55b30121d87b5fbf89c77494ac56146bd6333a22e473c3ff4555eaec","version":"0.1.0"},"selections":[{"binding":{"kind":"module-stub"},"id":"session-api-sign-in-flow","target":{"component":"session-api-sign-in-flow","host":"session-api","kind":"component"},"template":{"id":"module-stub","sha256":"07c32da0ca7211cd86c35ec521a7dbca94ebe2654560601e275d88ce8720cb1d","version":"0.1.0"}},{"binding":{"kind":"module-stub"},"id":"session-api-api-forwarding","target":{"component":"session-api-api-forwarding","host":"session-api","kind":"component"},"template":{"id":"module-stub","sha256":"07c32da0ca7211cd86c35ec521a7dbca94ebe2654560601e275d88ce8720cb1d","version":"0.1.0"}},{"binding":{"identity":{"element":"identity","guard":"link-api-sign-in"},"kind":"verified-identity"},"id":"link-api-sign-in","target":{"component":"link-api-sign-in","host":"link-api","kind":"component"},"template":{"id":"verified-identity","sha256":"c321a5d7392e9a9a15cf73d8cf2db427b5533150e33d716c47c5edb49ad7e492","version":"0.1.0"}},{"binding":{"kind":"module-stub"},"id":"link-api-link-operations","target":{"component":"link-api-