# Generated by Jeeves from the design. Do not edit: it's rewritten on every generation.
# The nginx image fills in ${PORT} and the API_* variables from the environment at startup.
server {
    listen ${PORT};
    root /usr/share/nginx/html;
    # Docker's DNS, asked again every 10 s so a restarted service's new address is used.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /jeeves-config.json {
        add_header Cache-Control "no-store";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # qrwty (rest-api-client qrwty-client): /_api/qrwty/... goes to the qrwty service.
    location /_api/qrwty/ {
        set $jeeves_upstream ${API_QRWTY_URL};
        rewrite ^/_api/qrwty/(.*)$ /$1 break;
        proxy_pass $jeeves_upstream;
    }

    # Public contract extension followQr on qrwty.
    location ~ ^/q/[^/]+$ {
        set $jeeves_upstream ${API_QRWTY_URL};
        proxy_pass $jeeves_upstream;
    }

    # Client-side routes: any other path gets the app.
    location / {
        try_files $uri /index.html;
    }
}
